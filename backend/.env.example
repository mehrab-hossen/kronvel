ENVIRONMENT=development
LOG_LEVEL=INFO
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://kronvel:kronvel@postgres:5432/kronvel
PROMETHEUS_URL=http://prometheus:9090
DRY_RUN_DEFAULT=true

PIPELINE_POLL_INTERVAL_SECONDS=5
ANOMALY_TEMP_Z_THRESHOLD=3.5
ANOMALY_TEMP_ABSOLUTE_THRESHOLD_C=85.0
ANOMALY_TEMP_CRITICAL_THRESHOLD_C=95.0

# Path to the kubeconfig used by the backend. For Docker Compose, this should
# match the path where the kubeconfig is mounted inside the container.
KUBE_CONFIG_PATH=/home/kronvel/.kube/config
KUBE_IN_CLUSTER=false

OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=openai/gpt-5-mini